# Copy to /opt/irantala/app/.env on the server. Never commit the real file.
PUBLIC_HOST=185.26.32.176
MONGO_USER=
MONGO_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
IAM_SIGNING_KEY_ID=iam-YYYYMM
IAM_OTP_SECRET=
# Mixed into every password hash; never change it once users have passwords.
IAM_PASSWORD_PEPPER=
SUPER_ADMIN_PHONE=
# Automatic KYC (Shahkar + civil registry). Off: requests wait for an admin. The server IP must be whitelisted at Jibit.
JIBIT_ENABLED=false
JIBIT_API_KEY=
JIBIT_SECRET_KEY=
MEDIANA_API_KEY=
MEDIANA_SENDER_NUMBER=
MEDIANA_OTP_PATTERN=
# Price feed. Simulated is for test servers only; production uses the real sources.
MARKET_SIMULATED=false
MARKET_TGNSRV_ENABLED=false
MARKET_TGNSRV_URL=
MARKET_STREAMDATA_ENABLED=false
MARKET_STREAMDATA_URL=
